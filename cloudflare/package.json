{
  "name": "portfolio-cms-cloudflare",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create portfolio-cms",
    "db:migrate:local": "wrangler d1 migrations apply portfolio-cms --local",
    "db:migrate:remote": "wrangler d1 migrations apply portfolio-cms --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.20.0"
  }
}
