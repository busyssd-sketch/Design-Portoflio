# Public flag used to enable CMS upload controls in the dashboard.
NEXT_PUBLIC_CMS_ENABLED=true

# Server-side URL of your deployed Cloudflare Worker, e.g.
# https://portfolio-cms-api.<your-subdomain>.workers.dev
CLOUDFLARE_CMS_API_URL=https://REPLACE_WITH_WORKER_URL

# Must be exactly the same value as the Worker CMS_SESSION_SECRET.
# Generate with: openssl rand -base64 48
CMS_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
